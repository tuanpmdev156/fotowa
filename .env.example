# Copy this file to `.env` and fill in real values. 

# --- target environment ---
BASE_URL=https://master.review.fotowa.com

# --- test account ---
TEST_EMAIL=
TEST_PASSWORD=

# --- auth strategy ---
# 1 = reuse the persistent Chrome profile in .auth/chrome-profile
# unset/0 = reuse .auth/storage_state.json written by scripts/save_auth.py
USE_CHROME_PROFILE=

# --- paths (optional, defaults are fine) ---
# AUTH_DIR=.auth
# AUTH_STATE=.auth/storage_state.json
# AUTOMATION_PROFILE_DIR=.auth/chrome-profile
