# Copy this file to `.env` and fill in real values. 

# --- target environment ---
BASE_URL=https://master.review.fotowa.com

# --- test account ---
TEST_EMAIL=
TEST_PASSWORD=

# --- auth strategy ---
# 1 = reuse the persistent Chrome profile in .auth/chrome-profile
# 0 = reuse .auth/storage_state.json written by scripts/save_auth.py
USE_CHROME_PROFILE=0

# --- timeouts (optional) ---
# Playwright action/navigation/assertion timeout for tests, in ms (default 30000).
#DEFAULT_TIMEOUT_MS=30000
# How long scripts/save_auth.py waits for you to finish Google SSO (default 300000).
#GOOGLE_SSO_LOGIN_TIMEOUT_MS=300000

# --- paths (optional, defaults are fine) ---
# AUTH_DIR=.auth
# AUTH_STATE=.auth/storage_state.json
# AUTOMATION_PROFILE_DIR=.auth/chrome-profile
